# ─────────────────────────────────────────────────────────────
# GrowLokal — environment template. Copy to .env and fill in.
# NEVER commit the real .env. All secrets live here only.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
PUBLIC_API_URL=https://api.growlokal.com     # public URL (via Cloudflare Tunnel / Caddy)

# --- Database (Postgres 16 — local, Proxmox ct-postgres, or docker-compose.prod.yml) ---
DATABASE_URL=postgres://growlokal:CHANGE_ME@localhost:5432/growlokal

# --- Redis (WhatsApp conversation state — survives restarts, multi-instance safe) ---
REDIS_URL=redis://localhost:6379

# --- Meta WhatsApp Cloud API ---
# See Technical-Setup-Guide.md §4
WHATSAPP_PHONE_NUMBER_ID=            # from WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=               # PERMANENT system-user token (secret!)
WHATSAPP_VERIFY_TOKEN=make_up_a_random_string   # you invent this; used in webhook GET verify
WHATSAPP_API_VERSION=v21.0
# Meta App Secret (App Dashboard > Settings > Basic) — verifies inbound
# webhook signatures (X-Hub-Signature-256). REQUIRED in production; without
# it anyone who finds the webhook URL can trigger paid LLM/Places calls.
WHATSAPP_APP_SECRET=

# --- Google APIs ---
# Places API (audit bot + autocomplete) — RESTRICT this key + set a billing cap!
GOOGLE_PLACES_API_KEY=
# Google Business Profile — static fallback token (single-account pilot; no
# refresh needed but expires periodically and must be swapped in by hand)
GBP_ACCESS_TOKEN=
# Per-business OAuth refresh flow (clients/gbp-oauth.ts) — set these once you
# create an OAuth 2.0 Client ID in Google Cloud Console. Each business's own
# refresh token is stored in the DB (businesses.gbp_refresh_token), not here —
# see the header comment in clients/gbp-oauth.ts for the one-time setup.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=

# --- Email (Amazon SES) — used for payment confirmations, invoices, renewal
# reminders. Empty in dev (logs instead of sending).
SES_REGION=ap-south-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM=hello@growlokal.com

# --- Renewal reminders ---
# WhatsApp template for the 7-day-before renewal reminder — needs Meta
# approval first (external, like GBP). Leave blank until you have one; the
# reminder job still sends email, just skips WhatsApp with a warning logged.
WHATSAPP_RENEWAL_TEMPLATE_NAME=

# --- Pay-first checkout (Chunk C) ---
# Template for "payment confirmed, here's how to log in" — same external
# approval situation as above. Leave blank until approved.
WHATSAPP_PAYMENT_CONFIRMATION_TEMPLATE_NAME=
# "Get a Website" button alert (WhatsApp side) — email alert below works without this.
WHATSAPP_WEBSITE_REQUEST_TEMPLATE_NAME=
OPS_ALERT_PHONE=
OPS_ALERT_EMAIL=
DASHBOARD_LOGIN_URL=https://app.growlokal.com/login

# --- LLM providers ---
# Use Gemini Flash / Claude Haiku for bulk, Sonnet/2.5 for quality vernacular.
# LLM_PROVIDER=ollama requires Ollama running on Proxmox (OLLAMA_BASE_URL below).
# LLM_PROVIDER=openrouter routes through OpenRouter (falls back to Gemini if unset).
LLM_PROVIDER=gemini                  # gemini | openrouter | anthropic | ollama
LLM_MODEL_CHEAP=gemini-2.0-flash-lite
LLM_MODEL_QUALITY=gemini-2.5-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Only used when LLM_PROVIDER=openrouter. Verify against https://openrouter.ai/models
# before relying on them in production — model IDs change.
OPENROUTER_MODEL_CHEAP=google/gemini-2.0-flash-lite-001
OPENROUTER_MODEL_QUALITY=anthropic/claude-haiku-4.5
ANTHROPIC_API_KEY=
# Optional local model for drafts (Ollama on Proxmox)
OLLAMA_BASE_URL=http://10.0.0.40:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Auth (dashboard) ---
# Long random value REQUIRED in production — the app refuses to boot with
# the dev default when NODE_ENV=production.
JWT_SECRET=CHANGE_ME_long_random_string

# --- SMS (MSG91 — cheap Indian aggregator; needs DLT registration) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GRWLKL
MSG91_OTP_TEMPLATE_ID=

# --- Mixpost (self-hosted social scheduler on Proxmox) ---
MIXPOST_BASE_URL=
MIXPOST_TOKEN=
MIXPOST_WORKSPACE_UUID=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (paise; ₹999 / ₹2,499) --- Pro plan dropped 2026-08-18.
PRICE_STARTER_PAISE=99900
PRICE_GROWTH_PAISE=249900

# --- Image generation (FLUX.2 Klein 4B via OpenRouter) + Cloudflare R2 storage ---
# Empty R2 vars = image generation silently no-ops (caption-only posts still ship).
OPENROUTER_MODEL_IMAGE=black-forest-labs/flux.2-klein-4b
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=growlokal-media
R2_PUBLIC_URL_BASE=

# --- QuickChart (WhatsApp "My Stats" chart image) ---
QUICKCHART_BASE_URL=https://quickchart.io
