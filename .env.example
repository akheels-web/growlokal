# ─────────────────────────────────────────────────────────────
# Prachaar — environment template. Copy to .env and fill in.
# NEVER commit the real .env. All secrets live here only.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
PUBLIC_API_URL=https://api.yourdomain.in     # public URL (via Cloudflare Tunnel)

# --- Database (Postgres 16 — local or Proxmox ct-postgres) ---
DATABASE_URL=postgres://prachaar:CHANGE_ME@localhost:5432/prachaar

# --- Meta WhatsApp Cloud API ---
# See Technical-Setup-Guide.md §4
WHATSAPP_PHONE_NUMBER_ID=            # from WhatsApp > API Setup
WHATSAPP_WABA_ID=                    # WhatsApp Business Account ID (only needed for
                                     # template management via API — feature not built yet)
WHATSAPP_ACCESS_TOKEN=               # PERMANENT system-user token (secret!)
WHATSAPP_VERIFY_TOKEN=make_up_a_random_string   # you invent this; used in webhook GET verify
WHATSAPP_API_VERSION=v21.0

# --- Google APIs ---
# Places API (audit bot) — RESTRICT this key + set a billing cap!
GOOGLE_PLACES_API_KEY=
# Google Business Profile OAuth — (feature not built yet: OAuth refresh flow
# is a TODO; code currently uses the static GBP_ACCESS_TOKEN below as a stopgap)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# --- LLM providers ---
# Use Gemini Flash / Claude Haiku for bulk, Sonnet/2.5 for quality vernacular.
# LLM_PROVIDER=ollama requires Ollama running on Proxmox (OLLAMA_BASE_URL below).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini                  # gemini | anthropic | ollama
LLM_MODEL_CHEAP=gemini-2.0-flash-lite
LLM_MODEL_QUALITY=gemini-2.5-flash
# Optional local model for drafts (Ollama on Proxmox)
OLLAMA_BASE_URL=http://10.0.0.40:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Auth (dashboard) ---
JWT_SECRET=CHANGE_ME_long_random_string

# --- SMS (MSG91 — cheap Indian aggregator; needs DLT registration) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PRCHAR
MSG91_OTP_TEMPLATE_ID=

# --- Email (Amazon SES — cheapest) — FEATURE NOT BUILT YET ---
# No SES client exists in the code. Leave blank until the email feature is built.
SES_REGION=ap-south-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM=hello@yourdomain.in

# --- Mixpost (self-hosted social scheduler on Proxmox) ---
MIXPOST_BASE_URL=
MIXPOST_TOKEN=
MIXPOST_WORKSPACE_UUID=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (paise; ₹999 / ₹2,499 / ₹4,999) ---
PRICE_STARTER_PAISE=99900
PRICE_GROWTH_PAISE=249900
PRICE_PRO_PAISE=499900

# --- GBP direct token (until OAuth refresh flow is built) ---
GBP_ACCESS_TOKEN=
